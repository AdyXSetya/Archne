<?xml version="1.0" encoding="UTF-8"?>
<plugin id="archne-background" version="1.4.0" xmlns="http://apache.org/cordova/ns/plugins/1.0" xmlns:android="http://schemas.android.com/apk/res/android">
  <name>ArchneBackground</name>
  <description>Layanan latar depan (agar chat tetap tersambung) dan notifikasi pesan/panggilan masuk (foto profil, Balas, Tolak, Jawab).</description>
  <platform name="android">
    <config-file target="res/xml/config.xml" parent="/*">
      <feature name="ArchneBackground"><param name="android-package" value="com.xyraori.archne.ArchneBackground" /><param name="onload" value="true" /></feature>
    </config-file>
    <config-file target="AndroidManifest.xml" parent="/manifest">
      <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
      <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
      <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
      <uses-permission android:name="android.permission.WAKE_LOCK" />
      <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
      <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    </config-file>
    <config-file target="AndroidManifest.xml" parent="/manifest/application">
      <service android:name="com.xyraori.archne.ArchneService" android:exported="false" android:foregroundServiceType="dataSync|microphone" />
      <receiver android:name="com.xyraori.archne.ArchneReceiver" android:exported="false" />
    </config-file>
    <source-file src="src/android/ArchneBackground.java" target-dir="src/com/xyraori/archne" />
    <source-file src="src/android/ArchneService.java" target-dir="src/com/xyraori/archne" />
    <source-file src="src/android/ArchneReceiver.java" target-dir="src/com/xyraori/archne" />
    <source-file src="src/android/ArchneLang.java" target-dir="src/com/xyraori/archne" />
    <!-- teks native dua bahasa (en bawaan, id = values-in); nama berkas khusus supaya tidak bentrok dengan strings.xml aplikasi -->
    <resource-file src="src/android/res/values/archne_strings.xml" target="app/src/main/res/values/archne_strings.xml" />
    <resource-file src="src/android/res/values-in/archne_strings.xml" target="app/src/main/res/values-in/archne_strings.xml" />
    <!-- ikon kecil notifikasi (gelembung chat, putih); di bawah src/ supaya perubahannya ikut hash plugin dan memicu pemasangan ulang -->
    <resource-file src="src/android/res/drawable/ic_stat_archne.xml" target="app/src/main/res/drawable/ic_stat_archne.xml" />
  </platform>
</plugin>
