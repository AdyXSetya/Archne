{
  "name": "archne",
  "version": "1.0.0",
  "private": true,
  "description": "Serverless peer-to-peer messenger with a built-in personal web host: chat, calls, file sharing, and PHP/SQLite sites from your own device.",
  "keywords": [
    "p2p",
    "peer-to-peer",
    "messenger",
    "chat",
    "webrtc",
    "video-call",
    "file-sharing",
    "local-first",
    "serverless",
    "self-hosted",
    "electron",
    "capacitor",
    "android",
    "php",
    "sqlite",
    "nodejs"
  ],
  "homepage": "https://github.com/AdyXSetya/archne#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AdyXSetya/archne.git"
  },
  "bugs": {
    "url": "https://github.com/AdyXSetya/archne/issues"
  },
  "main": "main.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "electron .",
    "serve": "node server.js",
    "dist": "electron-builder --win",
    "setup": "node scripts/auto.js setup",
    "auto": "node scripts/auto.js"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "resedit": "3.1.0"
  },
  "build": {
    "appId": "com.xyraori.archne",
    "productName": "Archne",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/**",
      "src/**",
      "renderer/**",
      "vendor/**",
      "!node_modules/@php-wasm/node-8-[0-2]/**",
      "!node_modules/@php-wasm/node-7-*/**",
      "!node_modules/@php-wasm/node-8-[4-9]/**",
      "!node_modules/@php-wasm/node-5-*/**"
    ],
    "forceCodeSigning": false,
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "afterPack": "scripts/after-pack.js",
    "asarUnpack": [
      "node_modules/@php-wasm/**/*.wasm",
      "node_modules/@php-wasm/**/*.node"
    ]
  },
  "dependencies": {
    "ws": "^8.18.0",
    "@php-wasm/node": "3.1.54",
    "@php-wasm/node-8-3": "3.1.54",
    "@php-wasm/universal": "3.1.54",
    "@php-wasm/util": "3.1.54",
    "fs-ext-extra-prebuilt": "file:vendor/fs-ext-stub"
  },
  "author": "xyraori",
  "license": "MIT",
  "overrides": {
    "fs-ext-extra-prebuilt": "$fs-ext-extra-prebuilt"
  }
}
